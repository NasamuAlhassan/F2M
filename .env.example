# ---- Farm to Market environment ----
# Copy to .env at the repo root (it is gitignored). Every provider defaults to
# mock, so a checkout runs with no keys at all; fill a section in when you
# switch that provider on.

# ── Server ──
PORT=3000
# Database (docs/HOSTING.md). Empty DATABASE_URL = a local Postgres (PGlite) in DATABASE_PATH,
# nothing to install. On Vercel: Supabase's session pooler URI (port 5432), set in Vercel only.
DATABASE_URL=
DATABASE_PATH=data/pglite
# Photos, recordings, voice clips: 'disk' (STORAGE_DIR) locally; 'supabase' on Vercel, which also
# needs SUPABASE_SERVICE_ROLE_KEY: server-only and secret, set in Vercel's server project, never in the web.
STORAGE_PROVIDER=disk
STORAGE_DIR=apps/server/storage
SUPABASE_SERVICE_ROLE_KEY=
# The secret Supabase's pg_cron sends to POST /api/cron/sweep (supabase/migrations/0003). Empty = closed;
# locally the sweep runs on timers instead.
CRON_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
DISPUTE_WINDOW_MINUTES=10

# ── AI grading: mock | hf ──
# HF_TOKEN: a fine-grained token with "Inference" permission (huggingface.co/settings/tokens)
GRADING_PROVIDER=mock
HF_TOKEN=
GRADING_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Where grading runs (any OpenAI-compatible host). Hugging Face by default, which needs paid
# credits once the free allowance is spent. On Groq's free tier instead:
#   GRADING_BASE_URL=https://api.groq.com/openai/v1  and  GRADING_MODEL=qwen/qwen3.8-27b
# and it reuses LLM_API_KEY (same host as the assist). GRADING_API_KEY overrides the key.
GRADING_BASE_URL=https://router.huggingface.co/v1
GRADING_API_KEY=

# ── Africa's Talking: SMS (mock | at) and voice calls (mock | at) ──
# Real SMS to Ghana needs an approved sender ID; real calls need a paid Ghana voice number.
# Keep USSD_SHORTCODE in quotes — an unquoted # starts a comment.
NOTIFY_PROVIDER=mock
VOICE_PROVIDER=mock
AT_USERNAME=sandbox
AT_API_KEY=
AT_VOICE_NUMBER=
USSD_SHORTCODE="*384*7247#"

# ── Language layer: mock | space (the Tɛkyerɛma language Space, keyless) ──
# The Space sleeps after ~2 days idle and loads each language on first use:
# warm each language with one call before a demo.
ASR_PROVIDER=mock
MT_PROVIDER=mock
TTS_PROVIDER=mock
SPACE_URL=https://princealhassannasamu-tekyerema-lang.hf.space

# 'true' (the owner's choice, D-049): Twi, Ewe, Dagbani, Hausa and Kusaal are live on SMS,
# USSD and voice — machine-translated by the language Space, not yet reviewed by native
# speakers. 'false' = every farmer surface stays English until a catalog is reviewed.
I18N_DRAFT_LOCALES_LIVE=true

# ── Web logins (Supabase — supabase/README.md) ──
# Project URL and publishable/anon key from Project Settings → API Keys; the
# server reads the URL too, to verify logins. Never the secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Phone simulator & carrier boundary ──
# 'true': the /phone simulator, USSD/IVR tester pages and their SMS inboxes work,
# so real numbers can be tested before a live USSD code exists — anyone who can
# reach the server can then act as any phone, so keep it to the test group.
# 'false' once Africa's Talking is live; then CARRIER_WEBHOOK_TOKEN is required
# and goes on the callback URLs you give AT (…/ussd?token=…, …/voice/answer?token=…).
SIMULATOR_ENABLED=true
CARRIER_WEBHOOK_TOKEN=

# Live prices (docs/PRICES.md). F2M's own deals and asking prices feed the price
# engine on their own; these add outside data.
# PRICE_FEED_HDX=true loads WFP's 2006-2023 Ghana history once at startup (seasonality).
PRICE_FEED_HDX=false
# PRICE_FEED_URL is polled every PRICE_FEED_INTERVAL_MINUTES for the JSON in docs/PRICES.md.
PRICE_FEED_URL=
PRICE_FEED_TOKEN=
PRICE_FEED_INTERVAL_MINUTES=360
# Lets a partner POST that JSON to /api/feeds/prices with "Authorization: Bearer <token>".
# At least 16 characters; the endpoint is closed while this is empty.
PRICE_INGEST_TOKEN=

# Smart alerts (docs/INTELLIGENCE.md): how many people one new listing or request may reach,
# the most alert SMS one farmer gets in a day, and how far a price must move in two weeks to be announced.
ALERT_MAX_RECIPIENTS=8
ALERT_SMS_PER_FARMER_PER_DAY=2
ALERT_PRICE_MOVE_PCT=10

# The language-model assist is OFF unless you switch it on. When it is on, short scrubbed pieces
# of text (a farmer's listing sentence, a buyer's typed request) go to an open model on an
# OpenAI-compatible host: Groq by default (free tier, key from console.groq.com). Any other
# such host works by changing the base URL, key and model (docs/DECISIONS.md D-059).
LLM_PROVIDER=off
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_VISION_MODEL=
LLM_TIMEOUT_MS=8000
