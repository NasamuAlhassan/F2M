# ---- Farm to Market environment ----
# Copy to .env at the repo root. Mock mode (the defaults) needs NO keys at all.

# Server
PORT=3000
JWT_SECRET=change-me-demo-secret
DATABASE_PATH=data/ftm.db
STORAGE_DIR=apps/server/storage
DISPUTE_WINDOW_MINUTES=10
PUBLIC_BASE_URL=http://localhost:3000

# Grading: mock | hf
GRADING_PROVIDER=mock
# HuggingFace router (only needed when GRADING_PROVIDER=hf)
# Create a fine-grained token with "Inference" permission at huggingface.co/settings/tokens
HF_TOKEN=
GRADING_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# Payments: mock | momo
PAYMENT_PROVIDER=mock
# MTN MoMo sandbox (only needed when PAYMENT_PROVIDER=momo)
# Subscribe to BOTH Collections and Disbursements at momodeveloper.mtn.com,
# then run: npm run momo:provision   (fills MOMO_API_USER / MOMO_API_KEY)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUB_KEY_COLLECTIONS=
MOMO_SUB_KEY_DISBURSEMENTS=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=sandbox
MOMO_CURRENCY=EUR

# SMS notifications: mock | at   (mock logs to the outbox; at sends via Africa's Talking)
NOTIFY_PROVIDER=mock
# Africa's Talking (needed when NOTIFY_PROVIDER=at; USSD webhook needs no key)
AT_USERNAME=sandbox
AT_API_KEY=
# The shortcode quoted inside SMS messages ("Dial ... to view")
USSD_SHORTCODE="*384*7247#"

# Voice/IVR: mock | at   (mock queues calls the ivr-tester page answers; at places real AT Voice calls)
VOICE_PROVIDER=mock
# Africa's Talking voice number (needed when VOICE_PROVIDER=at)
AT_VOICE_NUMBER=
VOICE_ANSWER_TIMEOUT_MS=120000

# Voice listing + language day (D-038, D-040): Khaya AI (GhanaNLP) providers.
# All three ride one free key from https://ghananlp.org — flip a provider to
# 'khaya' once KHAYA_API_KEY is set. Mock: ASR echoes the tester's typed
# transcript, MT is passthrough, TTS answers null (IVR keeps <Say>).
ASR_PROVIDER=mock
MT_PROVIDER=mock
TTS_PROVIDER=mock
KHAYA_API_KEY=

# Review gate escape hatch (D-040), owner's live testing ONLY: 'true' lets
# machine-drafted catalogs reach farmer-facing SMS/USSD/IVR before native
# review. Default 'false' — drafts preview in the simulation drawer only, and
# every farmer surface resolves unreviewed locales to English.
I18N_DRAFT_LOCALES_LIVE=false

# Unified role-picker auth (buyer/seller/driver signup, supabase/README.md).
# Create a project, run supabase/migrations/0001_profiles.sql, then
# Project Settings -> API for these two. The anon key is meant for the
# browser — row-level security protects the data, not secrecy of this key.
# Never put the service_role key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force the auth screens onto the local mock backend (lib/mockAuth.ts) even
# when the two keys above are filled in — for previewing /auth without
# waiting on Supabase email confirmation, or pausing the real backend
# without deleting keys you already set up. 'false' (or unset) uses real
# Supabase whenever configured.
VITE_FORCE_MOCK_AUTH=false
