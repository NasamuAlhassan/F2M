# ---- Unified auth (Supabase) ----
# Copy to apps/web/.env. See supabase/README.md for how to get these values —
# create a project, run supabase/migrations/0001_profiles.sql, then
# Project Settings -> API for the URL and anon key.
#
# The anon key is safe in browser code; row-level security (not secrecy of
# this key) is what protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
