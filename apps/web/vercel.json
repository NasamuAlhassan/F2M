{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/api/:path*"
    },
    {
      "source": "/ussd",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/ussd"
    },
    {
      "source": "/voice/:path*",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/voice/:path*"
    },
    {
      "source": "/photos/:path*",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/photos/:path*"
    },
    {
      "source": "/tts/:path*",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/tts/:path*"
    },
    {
      "source": "/recordings/:path*",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/recordings/:path*"
    },
    {
      "source": "/health",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/health"
    },
    {
      "source": "/ussd-tester.html",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/ussd-tester.html"
    },
    {
      "source": "/ivr-tester.html",
      "destination": "https://REPLACE-WITH-YOUR-SERVER.vercel.app/ivr-tester.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
