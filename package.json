{
  "name": "farm-to-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @ftm/server\" \"npm run dev -w @ftm/web\"",
    "db:reset": "npm run db:reset -w @ftm/core",
    "db:inspect": "npm run db:inspect -w @ftm/core",
    "momo:provision": "npm run momo:provision -w @ftm/server",
    "demo": "npm run demo -w @ftm/server",
    "local-models": "local-models/.venv/bin/python local-models/server.py",
    "test": "vitest run",
    "check": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "i18n:draft": "npm run i18n:draft -w @ftm/core"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
